# -------- Stage 1: Build --------
FROM node:18 AS builder

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# -------- Stage 2: Production --------
FROM node:18-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app /app

RUN npm install --only=production

EXPOSE 3000

CMD ["node", "app.js"]
----------------------------------
FROM → Base image
LABEL → Metadata
ENV → Environment variables
WORKDIR → Working directory
COPY / ADD → Move files
RUN → Execute commands
USER → Security (non-root)
EXPOSE → Port
HEALTHCHECK → Monitor container
CMD → Default startup command
Multi-stage → Reduce image size
